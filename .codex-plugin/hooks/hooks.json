{
  "description": "Dev Kit lifecycle hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/acp-tier-assert.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/tdd-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/worktree-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/linear-autosync.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/git-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/review-yml-isolation.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/tdd-scope-judge.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/worktree-auto-cut.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/linear-task-change.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/notification-collapse.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/context-window-guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/session-start-check.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/log-on-session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/provider-divergence-check.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/linear-session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/slop-detector.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/l4-todo-scan.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/worktree-log-auto-install.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/loop-detect.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/linear-worktree-create.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/sub-agent-handoff.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/stop-verify.sh"
          }
        ]
      }
    ]
  }
}
