{
  "enabledPlugins": {
    "dev-kit@dev-kit": true
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for i in python3 python py; do if \"$i\" -c \"\" </dev/null >/dev/null 2>&1; then exec env SAVE_LOG_ARCHIVE_STALE=1 \"$i\" \"${CLAUDE_PROJECT_DIR}/tools/save_log.py\" --tool claude-code; fi; done"
          }
        ],
        "_loghooks_managed": true
      }
    ],
    "SessionStart": [
      {
        "_commands_dir_registered_by_install_commands": true,
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PROJECT_DIR}/bin/install-commands.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for i in python3 python py; do if \"$i\" -c \"\" </dev/null >/dev/null 2>&1; then exec env SAVE_LOG_ARCHIVE_STALE=1 \"$i\" \"${CLAUDE_PROJECT_DIR}/tools/save_log.py\" --tool claude-code; fi; done"
          }
        ],
        "_loghooks_managed": true
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(.worktrees/**)",
      "Read(.worktrees/**)",
      "Bash(git -C .worktrees/** *)",
      "Bash(git -C .worktrees/* *)",
      "Bash(cd .worktrees/* && git:*)"
    ],
    "ask": [],
    "deny": []
  }
}
