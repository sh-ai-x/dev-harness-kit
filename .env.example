# dev-harness-kit environment variables (template)
# Copy to `.env` and fill in. `.env` is gitignored.

# === Provider (MUST-44) ===
# GitHub.com default; Enterprise / Gitea override GH_HOST.
GH_HOST=github.com
GITHUB_TOKEN=ghp_replace_with_your_personal_access_token
GITLAB_TOKEN=glpat-replace_with_gitlab_pat

# === LLM Provider (default MiniMax, opt-in Anthropic) ===
MINMAX_API_KEY=sk-cp-replace_with_minimax_key
ANTHROPIC_API_KEY=sk-ant-replace_with_anthropic_key
DEEPSEEK_API_KEY=sk-replace_with_deepseek_key

# === CI review/security provider (.github/workflows/review.yml) ===
# One of: minimax / anthropic / deepseek. .githooks/pre-commit reads this
# on every commit and syncs .github/ci-review-provider.txt to match — CI
# can't read this file directly (GitHub-hosted runners never see your
# local .env), only the tracked file, so this is the "you edit .env, the
# tracked file follows on your next commit" source of truth. Requires the
# matching *_API_KEY above to be pushed as a GitHub repo secret
# (`gh secret set <NAME>_API_KEY < <(value)`) before switching to it.
CI_REVIEW_PROVIDER=minimax

# === LLM-as-Judge (MUST-32~34) ===
JUDGE_PROVIDER=minimax
JUDGE_MODEL=MiniMax-M3[1m]

# === Hook bypass (MUST-12, --strict mode only) ===
DEV_KIT_HOOK_OFF=

# === Feature flag override (MUST-26) ===
DEV_KIT_MCP=
DEV_KIT_SKILL_OFF=

# === Team mode (MUST-18) ===
# 1 = .dev-kit/ git include (override --team flag)
DEV_KIT_TEAM=0

# === Eval cadence (MUST-32, nightly cron) ===
DEV_KIT_EVAL_INTERVAL_HOURS=24
