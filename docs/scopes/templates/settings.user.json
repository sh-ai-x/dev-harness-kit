{
  "theme": "default",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": false,
  "permissions": {
    "allow": [
      "Edit(.worktrees/**)",
      "Read(.worktrees/**)",
      "Bash(git -C .worktrees/** status)",
      "Bash(git -C .worktrees/** log*)",
      "Bash(git -C .worktrees/** diff*)",
      "Bash(git -C .worktrees/** rev-parse*)",
      "Bash(git -C .worktrees/** worktree list)"
    ]
  },
  "extraKnownMarketplaces": {
    "dev-kit-lite": {
      "source": {
        "source": "github",
        "repo": "sh-ai-x/dev-harness-kit-lite"
      }
    }
  },
  "enabledPlugins": {}
}
