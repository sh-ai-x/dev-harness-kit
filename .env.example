# dev-harness-kit environment variables (template)
# Copy to `.env` and fill in. `.env` is gitignored.

# === Linear (https://linear.app/settings/api) ===
# Optional. Used by tools/linear_sync.py and the linear-autosync hook.
# Pick ONE of these sources (priority order, first match wins):
#   1. shell env:            export LINEAR_API_KEY=...
#   2. user-scope dotenv:    ~/.config/dev-kit/.env  (shared across repos)
#                            or $XDG_CONFIG_HOME/dev-kit/.env
#   3. per-worktree file:    <repo>/.dev-kit/.env.linear  (Linear-only by convention)
# Either way, run: python3 tools/linear_sync.py on  (per worktree).
# LINEAR_API_KEY=set-at-runtime
# LINEAR_TEAM_ID=                # optional
# LINEAR_PROJECT_NAME=           # optional override of repo basename

# === Provider (MUST-44) ===
# GitHub.com default; Enterprise / Gitea override GH_HOST.
GITHUB_TOKEN=set-at-runtime

# === LLM Provider (default MiniMax, opt-in Anthropic) ===
MINIMAX_API_KEY=set-at-runtime
ANTHROPIC_API_KEY=set-at-runtime
# DEEPSEEK_API_KEY — CI-only secret, not read by any local Python code.
# The .github/workflows/review.yml + maintenance.yml workflows map
# secrets.DEEPSEEK_API_KEY onto ANTHROPIC_API_KEY when CI_REVIEW_PROVIDER=deepseek.
# Operators on DeepSeek should `gh secret set DEEPSEEK_API_KEY` and skip
# the local .env entry entirely.
# DEEPSEEK_API_KEY=set-at-runtime   # commented out: CI-only

# === CI review/security provider (.github/workflows/review.yml) ===
# Local selection (per-user, gitignored): set here. To switch:
#   bin/set-provider.sh <minimax|anthropic|deepseek>
# It upserts this key in `.env` and prints the diff. `.env` is read
# only by tools running outside GitHub Actions.
#
# CI selection (per-repo, NOT in .env): the workflow reads the GitHub
# repo variable `vars.CI_REVIEW_PROVIDER`. Set it via:
#   gh variable set CI_REVIEW_PROVIDER --body <minimax|anthropic|deepseek>
# Then make sure the matching `*_API_KEY` above is also pushed as a
# repo secret (`gh secret set <NAME>_API_KEY --body '<value>'`).
CI_REVIEW_PROVIDER=minimax

# === LLM-as-Judge (MUST-32~34) ===
JUDGE_PROVIDER=minimax
JUDGE_MODEL=MiniMax-M3[1m]

# === Hook bypass (MUST-12, --strict mode only) ===
DEV_KIT_HOOK_OFF=

# === Feature flag override (MUST-26) ===

# === Team mode (MUST-18) ===
# 1 = .dev-kit/ git include (override --team flag)

# === Eval cadence (MUST-32, nightly cron) ===
