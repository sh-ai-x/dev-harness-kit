#!/usr/bin/env bash
# .githooks/pre-commit — Lint staged Python files with Ruff.
#
# History: this hook used to auto-rewrite .github/ci-review-provider.txt
# from .env:CI_REVIEW_PROVIDER on every commit. That behavior was removed
# in #230 because it silently inverted user intent and coupled a private,
# gitignored setting to CI's tracked configuration.
#
# The hook now validates staged content only. It never auto-fixes; fix findings
# explicitly, stage the result, and retry the commit. Version
# auto-bump remains in pre-push, whose --no-verify commits intentionally bypass
# this gate so the release flow cannot be blocked by unrelated staged files.
#
# Activation:
#   brew install ruff   # or: apt install ruff
#   git config core.hooksPath .githooks

set -euo pipefail

# Inspect the index before any tool-specific check. A clean worktree can hide
# conflict markers that are already staged for commit. The NUL-delimited
# capture preserves paths and matched content containing whitespace or quotes.
grep_tmp=$(mktemp "${TMPDIR:-/tmp}/pre-commit-grep.XXXXXX")
if git grep --cached -z -n -E '^[ \t]*(<{7}|={7}|\|{7}|>{7})' -- . > "$grep_tmp"; then
  echo "[pre-commit] BLOCKED: staged conflict marker found." >&2
  while IFS= read -r -d '' hit; do
    if [ -n "$hit" ]; then
      printf '%s\n' "$hit" >&2
    fi
  done < "$grep_tmp"
  rm -f -- "$grep_tmp"
  exit 1
else
  grep_status=$?
  rm -f -- "$grep_tmp"
  if [ "$grep_status" -ne 1 ]; then
    echo "[pre-commit] ERROR: unable to inspect staged content (git grep exited $grep_status)." >&2
    exit "$grep_status"
  fi
fi

# Use the staged diff, not `git ls-files`, so an unrelated staged text file
# cannot cause Ruff to re-check every tracked Python file in the repository.
# Capture NUL-delimited names in a file because Bash command substitution
# strips NUL bytes.
staged_list_tmp=$(mktemp "${TMPDIR:-/tmp}/pre-commit-staged-list.XXXXXX")
if git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' > "$staged_list_tmp"; then
  :
else
  diff_status=$?
  rm -f -- "$staged_list_tmp"
  echo "[pre-commit] ERROR: unable to list staged Python files (git diff exited $diff_status)." >&2
  exit "$diff_status"
fi

staged_files=()
while IFS= read -r -d '' file; do
  if [ -n "$file" ]; then
    staged_files+=("$file")
  fi
done < "$staged_list_tmp"
rm -f -- "$staged_list_tmp"

# Non-Python commits remain a no-op, even when Ruff is not installed.
if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

if ! command -v ruff >/dev/null 2>&1; then
  echo "[pre-commit] ::error:: ruff is required to lint staged Python files." >&2
  echo "[pre-commit] ::error:: Install:  brew install ruff   |   apt install ruff" >&2
  exit 1
fi

if repo_root=$(git rev-parse --show-toplevel); then
  :
else
  root_status=$?
  echo "[pre-commit] ERROR: unable to locate the repository root (git rev-parse exited $root_status)." >&2
  exit "$root_status"
fi

staged_dir=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-staged.XXXXXX")
cleanup() {
  rm -rf -- "$staged_dir"
}
trap cleanup EXIT

# Materialize the selected index entries once so Ruff sees exactly the blobs
# being committed, not unstaged edits in the worktree.
if git checkout-index --prefix="$staged_dir/" -- "${staged_files[@]}"; then
  :
else
  checkout_status=$?
  echo "[pre-commit] ERROR: unable to read staged Python blobs (git checkout-index exited $checkout_status)." >&2
  exit "$checkout_status"
fi

if (
  cd "$staged_dir"
  ruff check --no-fix --quiet --config "$repo_root/.ruff.toml" -- .
) >&2; then
  ruff_status=0
else
  ruff_status=$?
fi
if [ "$ruff_status" -ne 0 ]; then
  echo "[pre-commit] BLOCKED: commit blocked by Ruff findings." >&2
  echo "[pre-commit] Run: ruff check --fix -- ${staged_files[*]}" >&2
  echo "[pre-commit] Review the fixes, git add them, then retry the commit." >&2
  echo "[pre-commit] Emergency hotfix only: git commit --no-verify" >&2
  exit "$ruff_status"
fi

exit 0
