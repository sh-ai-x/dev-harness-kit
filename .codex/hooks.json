{
  "description": "Codex runtime hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "DEV_KIT_AGENT=codex bash \"$PWD/hooks/worktree-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "DEV_KIT_AGENT=codex bash \"$PWD/hooks/git-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$PWD/bin/install-commands.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DEV_KIT_AGENT=codex bash \"$PWD/hooks/trace-session-end.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "for i in python3 python py; do if \"$i\" -c \"\" </dev/null >/dev/null 2>&1; then env SAVE_LOG_ARCHIVE_STALE=1 \"$i\" tools/save_log.py --tool codex; exit 0; fi; done"
          }
        ],
        "_loghooks_managed": true
      }
    ]
  }
}
