#!/usr/bin/env bash
# .githooks/pre-commit — Lint staged Python files with Ruff.
#
# History: this hook used to auto-rewrite .github/ci-review-provider.txt
# from .env:CI_REVIEW_PROVIDER on every commit. That behavior was removed
# in #230 because it silently inverted user intent and coupled a private,
# gitignored setting to CI's tracked configuration.
#
# The hook now runs Ruff against staged Python files only. It never auto-fixes;
# fix findings explicitly, stage the result, and retry the commit. Version
# auto-bump remains in pre-push, whose --no-verify commits intentionally bypass
# this gate so the release flow cannot be blocked by unrelated staged files.
#
# Activation:
#   brew install ruff   # or: apt install ruff
#   git config core.hooksPath .githooks

set -euo pipefail

# Inspect the index before any tool-specific check.  A clean worktree can hide
# conflict markers or other invalid bytes that are already staged for commit.
# Exit 1 means no match; every other non-zero status is an index/read error.
#
# Use NUL-terminated output (-z) so paths and grep hits containing quote,
# backslash, space, tab, or newline bytes survive the round-trip intact.
# `git grep -z -n` emits `path<NUL>lineno:content<...>` blocks.
#
# The pattern is anchored with `^[ \t]*` so it only fires on the seven-char
# run at the start of a (possibly-indented) line. Caveat: a Markdown Setext
# underline (`=======` under a heading) still matches; deeper context-aware
# suppression would require multi-line state and is intentionally out of
# scope for this hook.
#
# NOTE: bash command substitution ($( ... )) silently strips NUL bytes from
# stdout, which would glue every hit together. We redirect directly to a
# temp file (NUL-preserving), read it back via `read -d ''`, and clean up
# before exit.
grep_tmp=$(mktemp "${TMPDIR:-/tmp}/pre-commit-grep.XXXXXX")
if git grep --cached -z -n -E '^[ \t]*(<{7}|={7}|\|{7}|>{7})' -- . > "$grep_tmp"; then
  echo "[pre-commit] BLOCKED: staged conflict marker found." >&2
  # Print one finding per line.
  while IFS= read -r -d '' hit; do
    if [ -n "$hit" ]; then
      # `%q` renders paths and matched content as a shell-safe, single-line
      # representation, so control bytes cannot spoof the terminal.
      printf '%q\n' "$hit" >&2
    fi
  done < "$grep_tmp"
  rm -f -- "$grep_tmp"
  exit 1
else
  grep_status=$?
  rm -f -- "$grep_tmp"
  if [ "$grep_status" -ne 1 ]; then
    echo "[pre-commit] ERROR: unable to inspect staged content (git grep exited $grep_status)." >&2
    exit "$grep_status"
  fi
fi

# Use `git ls-files -z` so filenames with embedded quote, backslash, space,
# tab, or newline bytes are emitted verbatim (no C-style quoting that would
# later confuse `git checkout-index`). `git diff --name-only` C-quotes such
# paths, which broke filenames like `quote"file.py` or `with space.py`.
#
# NOTE: bash command substitution ($( ... )) strips NUL bytes from the
# captured stdout, which would collapse every entry into one unreadable
# blob. We redirect directly to a file instead so the NUL delimiters
# survive intact; the file is `rm`-ed in the existing EXIT trap.
staged_list_tmp=$(mktemp "${TMPDIR:-/tmp}/pre-commit-staged-list.XXXXXX")
if git ls-files --cached -z -- '*.py' > "$staged_list_tmp"; then
  :
else
  diff_status=$?
  rm -f -- "$staged_list_tmp"
  echo "[pre-commit] ERROR: unable to list staged Python files (git ls-files exited $diff_status)." >&2
  exit "$diff_status"
fi

staged_files=()
while IFS= read -r -d '' file; do
  if [ -n "$file" ]; then
    staged_files+=("$file")
  fi
done < "$staged_list_tmp"
rm -f -- "$staged_list_tmp"

# Non-Python commits remain a no-op, even when Ruff is not installed.
if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

if ! command -v ruff >/dev/null 2>&1; then
  echo "[pre-commit] ::error:: ruff is required to lint staged Python files." >&2
  echo "[pre-commit] ::error:: Install:  brew install ruff   |   apt install ruff" >&2
  exit 1
fi

if repo_root=$(git rev-parse --show-toplevel); then
  :
else
  root_status=$?
  echo "[pre-commit] ERROR: unable to locate the repository root (git rev-parse exited $root_status)." >&2
  exit "$root_status"
fi

staged_dir=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-staged.XXXXXX")
cleanup() {
  rm -rf -- "$staged_dir"
}
trap cleanup EXIT

# Materialize the selected index entries once so Ruff can inspect all staged
# Python blobs in one process.  Keeping this separate from Ruff preserves the
# source of failures: an unreadable index entry is not reported as a lint fix.
if git checkout-index --prefix="$staged_dir/" -- "${staged_files[@]}"; then
  :
else
  checkout_status=$?
  echo "[pre-commit] ERROR: unable to read staged Python blobs (git checkout-index exited $checkout_status)." >&2
  exit "$checkout_status"
fi

if (
  cd "$staged_dir"
  ruff check --no-fix --quiet --config "$repo_root/.ruff.toml" -- .
) >&2; then
  ruff_status=0
else
  ruff_status=$?
fi
if [ "$ruff_status" -ne 0 ]; then
  echo "[pre-commit] BLOCKED: commit blocked by Ruff findings." >&2
  printf '[pre-commit] Run: ruff check --fix --' >&2
  printf ' %q' "${staged_files[@]}" >&2
  printf '\n' >&2
  echo "[pre-commit] Review the fixes, git add them, then retry the commit." >&2
  echo "[pre-commit] Emergency hotfix only: git commit --no-verify" >&2
  exit "$ruff_status"
fi

exit 0
