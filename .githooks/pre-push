#!/usr/bin/env bash
# .githooks/pre-push — Block direct push to main + enforce version freshness
# + opt-in LLM-judge intent check.
#
# Three responsibilities, run in order:
#   1. Block direct push to `main` (PR-only workflow policy).
#   2. Verify the LOCAL plugin version is >= origin/main's version. If
#      local is behind, AUTO-SYNC (not auto-bump) by calling
#      `bin/sync-version.sh` to copy origin/main's version field into
#      both plugin manifests, then commit that single-line change. The
#      trunk workflow (`.github/workflows/version-bump.yml`) still owns
#      the next version number — this hook only catches the branch up
#      to a version that origin/main already published, eliminating the
#      manual `git fetch && git rebase origin/main` cycle that previously
#      blocked every PR behind trunk. Auto-SYNC (==) is structurally
#      distinct from auto-BUMP (+1): only the latter caused the
#      parallel-PR cascade (every push incremented, every merge
#      conflicted) the bump-on-merge architecture was built to avoid.
#      If the sync can't run cleanly (e.g. plugin.json has uncommitted
#      edits the user is mid-way through), the hook falls back to a
#      clear error and refuses the push.
#   3. Opt-in: when DEV_KIT_PUSH_INTENT=1 is set, call
#      `python3 -m lib.push_intent_judge ...` with the tip commit's
#      message + `git diff --stat` summary. The judge returns
#      `VERDICT=<OK|DRIFT_WARNING|ROT> REASON="..."` on stdout. Anything
#      other than OK fails the push so a "rename + reformat only" or a
#      scope-creep drive-by doesn't slip through silently.
#
# Why pre-push (not pre-commit): the freshness check is only meaningful
# when the branch is going to origin. Pre-push fires once per push,
# comparing against origin/main which is the correct reference. The
# intent check is the same: it judges the commit as it will be pushed,
# not as it sits in the staging area.
#
# Activation:
#   git config core.hooksPath .githooks       # local-only
#   ./lib/install.sh --setup-hooks            # install.sh 자동 호출
#
# Bypass (for maintainers ONLY with explicit --no-verify, NEVER default):
#   git push --no-verify
#
# Intent-check opt-in (default OFF — keep hook offline-deterministic):
#   DEV_KIT_PUSH_INTENT=1 git push ...

set -eo pipefail

CLAUDE_PLUGIN=".claude-plugin/plugin.json"

if ! command -v jq >/dev/null 2>&1; then
  echo "[pre-push] ::error:: jq is required for version freshness check." >&2
  echo "[pre-push] ::error:: Install:  brew install jq   |   apt install jq" >&2
  exit 1
fi

# Read push lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    REMOTE_BRANCH="${REMOTE_REF#refs/heads/}"

    case "$REMOTE_BRANCH" in
        main|master)
            echo "[pre-push] BLOCKED: direct push to '$REMOTE_BRANCH' is disabled." >&2
            echo "" >&2
            echo "  Policy: this repo requires PR review before merge." >&2
            echo "" >&2
            echo "  Workflow:" >&2
            echo "    1. git checkout -b feat/<short-name>" >&2
            echo "    2. git push -u origin feat/<short-name>" >&2
            echo "    3. gh pr create --base main --head feat/<short-name>" >&2
            echo "    4. Wait for CI ✓ + (if reviewer assigned) approval" >&2
            echo "    5. Merge via 'gh pr merge' or GitHub UI button" >&2
            echo "" >&2
            echo "  Bypass (ONLY for emergency hotfix with explicit consent):" >&2
            echo "    git push --no-verify" >&2
            exit 1
            ;;
        "")
            # Tag push (e.g. `git push origin dev-kit--vX.Y.Z`). Skip the
            # freshness check — the user is just syncing a tag.
            ;;
        *)
            # === Version freshness check (auto-SYNC, not auto-BUMP) ===
            # Fetch origin/main so we can read its plugin.json:version as
            # the baseline. If the fetch fails (offline / no remote), skip
            # the check silently — CI freshness check is the backstop.
            if ! git fetch origin main 2>/dev/null; then
              echo "[pre-push] WARN: could not fetch origin/main; skipping version freshness check (CI is the backstop)"
              continue
            fi
            MAIN_VERSION="$(git show origin/main:"$CLAUDE_PLUGIN" 2>/dev/null | jq -r .version 2>/dev/null || echo "")"
            LOCAL_VERSION="$(jq -r .version "$CLAUDE_PLUGIN")"

            if [ -z "$MAIN_VERSION" ] || [ "$MAIN_VERSION" = "null" ]; then
              echo "[pre-push] WARN: origin/main has no plugin.json:version; skipping check"
              continue
            fi
            if [ -z "$LOCAL_VERSION" ] || [ "$LOCAL_VERSION" = "null" ]; then
              echo "[pre-push] ::error:: local plugin.json:version is empty or null" >&2
              exit 1
            fi

            # Compare using `sort -V` for version-aware ordering.
            HIGHER="$(printf '%s\n%s\n' "$MAIN_VERSION" "$LOCAL_VERSION" | sort -V | tail -1)"

            if [ "$HIGHER" = "$LOCAL_VERSION" ]; then
              echo "[pre-push] version $LOCAL_VERSION >= main $MAIN_VERSION; OK"
            else
              # local < origin/main: AUTO-SYNC. The trunk workflow owns
              # the version advance, so we copy origin/main's version
              # field into BOTH plugin manifests (single coherent
              # change) and commit it. This is sync (==), not bump (+1):
              # only the latter re-introduced the parallel-PR cascade.
              # If plugin.json has uncommitted edits, the sync would
              # clobber them; refuse the push and tell the user instead.
              if ! git diff --quiet -- "$CLAUDE_PLUGIN" 2>/dev/null \
                 || ! git diff --cached --quiet -- "$CLAUDE_PLUGIN" 2>/dev/null; then
                echo "[pre-push] ::error:: local $CLAUDE_PLUGIN has uncommitted changes; refusing to auto-sync" >&2
                echo "[pre-push] ::error:: Commit, stash, or discard your plugin.json edit first, then re-push." >&2
                echo "[pre-push] ::error:: (Sync target would be v$MAIN_VERSION from origin/main.)" >&2
                exit 1
              fi
              REPO_ROOT="$(git rev-parse --show-toplevel)"
              SYNC_SCRIPT="$REPO_ROOT/bin/sync-version.sh"
              if [ ! -x "$SYNC_SCRIPT" ]; then
                echo "[pre-push] ::error:: $SYNC_SCRIPT not found or not executable; cannot auto-sync" >&2
                echo "[pre-push] ::error:: Rebase onto origin/main (or fetch + rebase) and re-push." >&2
                exit 1
              fi
              if ! "$SYNC_SCRIPT" --target "$MAIN_VERSION"; then
                echo "[pre-push] ::error:: bin/sync-version.sh failed; refusing to push" >&2
                echo "[pre-push] ::error:: Rebase onto origin/main (or fetch + rebase) and re-push." >&2
                exit 1
              fi
              git add "$CLAUDE_PLUGIN"
              # Only stage .codex-plugin/plugin.json if it exists — the
              # sync script silently skips a missing manifest (single-
              # runtime checkout), and `git add` of a non-existent path
              # would error out and abort the auto-sync.
              if [ -f .codex-plugin/plugin.json ]; then
                git add .codex-plugin/plugin.json
              fi
              git commit -m "chore(sync): advance plugin.json from v$LOCAL_VERSION to v$MAIN_VERSION (origin/main drift)"
              echo "[pre-push] auto-synced v$LOCAL_VERSION -> v$MAIN_VERSION; continuing push"
            fi

            # === Opt-in LLM-judge intent check (DEV_KIT_PUSH_INTENT=1) ===
            # Skip on tag pushes (REMOTE_BRANCH=="") and on the
            # initial empty-commit push (LOCAL_SHA parents to nothing).
            if [ "${DEV_KIT_PUSH_INTENT:-}" = "1" ]; then
              # Defensive: a zero-length LOCAL_SHA means there's no
              # commit to judge (e.g. deleting a remote ref). Skip.
              if [ "${#LOCAL_SHA}" -lt 7 ]; then
                echo "[pre-push] push-intent: empty commit sha; skipping intent check"
              else
                # Capture commit message + diff stat + ~2 KB diff hunk
                # sample for the judge. Use a tmpfile to avoid quoting
                # issues when the commit message contains single quotes.
                tmpdir="$(mktemp -d)"
                trap 'rm -rf "$tmpdir"' EXIT
                git log -1 --format=%B "$LOCAL_SHA" > "$tmpdir/commit_msg.txt"
                git diff --stat "$LOCAL_SHA"~1 "$LOCAL_SHA" > "$tmpdir/diff_stat.txt" 2>/dev/null \
                  || git diff --stat "$LOCAL_SHA" > "$tmpdir/diff_stat.txt"
                # Trim diff sample to ~2 KB so the prompt stays bounded.
                git diff "$LOCAL_SHA"~1 "$LOCAL_SHA" 2>/dev/null \
                  | head -c 2048 > "$tmpdir/diff_sample.txt" \
                  || git diff "$LOCAL_SHA" | head -c 2048 > "$tmpdir/diff_sample.txt"

                echo "[pre-push] push-intent: judging commit $LOCAL_SHA via lib.push_intent_judge"
                push_intent_out="$(
                  DEV_KIT_PUSH_INTENT=1 python3 -m lib.push_intent_judge \
                    --project-root "$PWD" \
                    --commit-message "$(cat "$tmpdir/commit_msg.txt")" \
                    --diff-stat "$(cat "$tmpdir/diff_stat.txt")" \
                    --diff-sample "$(cat "$tmpdir/diff_sample.txt")" \
                    2>/dev/null || true
                )"

                if [ -z "$push_intent_out" ]; then
                  echo "[pre-push] ::error:: push-intent: lib.push_intent_judge produced no output" >&2
                  echo "[pre-push] ::error:: run \`python3 -m lib.push_intent_judge --help\` to verify install" >&2
                  exit 1
                fi

                case "$push_intent_out" in
                  "VERDICT=OK "*)
                    echo "[pre-push] push-intent: OK ($push_intent_out)"
                    ;;
                  "VERDICT=ROT "*|"VERDICT=DRIFT_WARNING "*)
                    echo "[pre-push] ::error:: push-intent REJECTED: $push_intent_out" >&2
                    echo "[pre-push] ::error:: Either rewrite the commit (clearer intent, scoped diff)" >&2
                    echo "[pre-push] ::error:: or bypass with \`git push --no-verify\`." >&2
                    exit 1
                    ;;
                  *)
                    # Unknown output shape — fail loud so a broken
                    # CLI can't silently approve a bad commit.
                    echo "[pre-push] ::error:: push-intent: unexpected output: $push_intent_out" >&2
                    exit 1
                    ;;
                esac
              fi
            fi
            ;;
    esac
done

exit 0